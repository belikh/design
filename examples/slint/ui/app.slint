import { Jupiter } from "jupiter.slint";
import { FontsLoaded } from "fonts.slint";
import { JIcon, JToggle, NavItem } from "components.slint";
import { Data } from "data.slint";
import { OverviewPage } from "pages/overview.slint";
import { MetricsPage } from "pages/metrics.slint";
import { AlertsPage } from "pages/alerts.slint";
import { TablesPage } from "pages/tables.slint";
import { InvoicePage } from "pages/invoice.slint";
import { DocumentsPage } from "pages/documents.slint";
import { NetworkPage } from "pages/network.slint";
import { SettingsPage } from "pages/settings.slint";
export { Jupiter, Data }

export component App inherits Window {
    title: "Jupiter design system: Slint demo";
    preferred-width: 1180px;
    preferred-height: 860px;
    min-width: 900px;
    background: Jupiter.bg;
    default-font-family: Jupiter.font-sans;
    default-font-size: Jupiter.font-sm;

    in-out property <int> page: 0;

    HorizontalLayout {
        // ---- sidebar
        Rectangle {
            width: 220px;
            background: Jupiter.surface;
            Rectangle { x: parent.width - 1px; width: 1px; background: Jupiter.border; }
            VerticalLayout {
                padding: Jupiter.space-4;
                spacing: Jupiter.space-1;
                HorizontalLayout {
                    spacing: Jupiter.space-2;
                    padding-bottom: Jupiter.space-4;
                    JIcon { source: @image-url("assets/icon/sparkle.svg"); size: 22px; tint: Jupiter.accent; }
                    Text { text: "jupiter /ds"; font-family: Jupiter.font-mono; font-size: Jupiter.font-md; font-weight: 700; color: Jupiter.text; vertical-alignment: center; }
                }
                NavItem { icon: @image-url("assets/icon/home.svg"); label: "Overview"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { icon: @image-url("assets/icon/chart.svg"); label: "Metrics"; active: root.page == 1; clicked => { root.page = 1; } }
                NavItem { icon: @image-url("assets/icon/bell.svg"); label: "Alerts"; active: root.page == 2; clicked => { root.page = 2; } }
                NavItem { icon: @image-url("assets/icon/database.svg"); label: "Tables"; active: root.page == 3; clicked => { root.page = 3; } }
                NavItem { icon: @image-url("assets/icon/card.svg"); label: "Invoice"; active: root.page == 4; clicked => { root.page = 4; } }
                NavItem { icon: @image-url("assets/icon/file.svg"); label: "Documents"; active: root.page == 5; clicked => { root.page = 5; } }
                NavItem { icon: @image-url("assets/icon/router.svg"); label: "Network"; active: root.page == 6; clicked => { root.page = 6; } }
                NavItem { icon: @image-url("assets/icon/settings.svg"); label: "Settings"; active: root.page == 7; clicked => { root.page = 7; } }
                Rectangle { }
                HorizontalLayout {
                    spacing: Jupiter.space-2;
                    JIcon { source: Jupiter.dark ? @image-url("assets/icon/moon.svg") : @image-url("assets/icon/sun.svg"); size: 18px; tint: Jupiter.text-muted; }
                    Text { text: Jupiter.dark ? "Dark" : "Light"; color: Jupiter.text-muted; font-family: Jupiter.font-mono; font-size: Jupiter.font-xs; vertical-alignment: center; horizontal-stretch: 1; }
                    JToggle { checked: Jupiter.dark; toggled(c) => { Jupiter.dark = c; } }
                }
            }
        }

        // ---- main
        Flickable {
            min-height: 600px;
            horizontal-stretch: 1;
            content-height: max(self.height, content.preferred-height + 2 * Jupiter.pad);
            content := VerticalLayout {
                x: Jupiter.pad;
                y: Jupiter.pad;
                width: parent.width - 2 * Jupiter.pad;
                alignment: start;
                if root.page == 0 : OverviewPage { }
                if root.page == 1 : MetricsPage { }
                if root.page == 2 : AlertsPage { }
                if root.page == 3 : TablesPage { }
                if root.page == 4 : InvoicePage { }
                if root.page == 5 : DocumentsPage { }
                if root.page == 6 : NetworkPage { }
                if root.page == 7 : SettingsPage { }
            }
        }
    }
}
