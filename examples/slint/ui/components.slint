// Themed building blocks. Everything reads the generated `Jupiter` global; nothing is hard-coded.
import { Jupiter } from "jupiter.slint";

// Graphics are single strokes in currentColor, so `colorize` tints them from the theme.
export component JIcon inherits Image {
    in property <length> size: 20px;
    in property <color> tint: Jupiter.text;
    width: size;
    height: size;
    colorize: tint;
    image-fit: contain;
}

export component JButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <image> icon;
    callback clicked();
    height: Jupiter.control-height;
    border-radius: Jupiter.radius-md;
    border-width: primary ? 0px : 1px;
    border-color: Jupiter.border;
    background: primary
        ? (ta.pressed ? Jupiter.accent.darker(0.2) : ta.has-hover ? Jupiter.accent.brighter(0.1) : Jupiter.accent)
        : (ta.has-hover ? Jupiter.surface-raised : Jupiter.surface);
    animate background { duration: Jupiter.dur-fast; }
    HorizontalLayout {
        padding-left: Jupiter.space-3;
        padding-right: Jupiter.space-3;
        spacing: Jupiter.space-2;
        alignment: center;
        VerticalLayout {
            alignment: center;
            JIcon { source: root.icon; size: 16px; tint: root.primary ? Jupiter.on-accent : Jupiter.text; }
        }
        Text {
            text: root.text;
            color: root.primary ? Jupiter.on-accent : Jupiter.text;
            font-family: Jupiter.font-sans;
            font-size: Jupiter.font-sm;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component JBadge inherits Rectangle {
    in property <string> text;
    in property <string> kind: "info";
    height: 20px;
    border-radius: Jupiter.radius-sm;
    background: kind == "ok" ? Jupiter.ok-bg : kind == "warn" ? Jupiter.warn-bg : kind == "danger" ? Jupiter.danger-bg : Jupiter.info-bg;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text.to-uppercase();
            color: root.kind == "ok" ? Jupiter.ok : root.kind == "warn" ? Jupiter.warn : root.kind == "danger" ? Jupiter.danger : Jupiter.info;
            font-family: Jupiter.font-mono;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

export component JToggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Jupiter.accent : Jupiter.border;
    animate background { duration: Jupiter.dur-fast; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Jupiter.surface-raised;
        animate x { duration: Jupiter.dur-fast; easing: ease-out; }
    }
    // The parent owns the state: it flips whatever `checked` is bound to, so two toggles on one setting never disagree.
    TouchArea { clicked => { root.toggled(!root.checked); } }
}

export component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> delta;
    in property <bool> good: true;
    height: 104px;
    background: Jupiter.surface-raised;
    border-width: 1px;
    border-color: Jupiter.border;
    border-radius: Jupiter.radius-md;
    VerticalLayout {
        padding: Jupiter.space-4;
        spacing: Jupiter.space-1;
        Text { text: root.label.to-uppercase(); font-family: Jupiter.font-mono; font-size: Jupiter.font-xs; color: Jupiter.text-muted; }
        Text { text: root.value; font-family: Jupiter.font-sans; font-size: Jupiter.font-2xl; font-weight: 800; color: Jupiter.text; }
        Text { text: root.delta; font-family: Jupiter.font-mono; font-size: Jupiter.font-xs; color: root.good ? Jupiter.ok : Jupiter.danger; }
    }
}

export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: Jupiter.radius-md;
    background: active ? Jupiter.accent : (ta.has-hover ? Jupiter.surface-raised : transparent);
    animate background { duration: Jupiter.dur-fast; }
    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            JIcon { source: root.icon; size: 18px; tint: root.active ? Jupiter.on-accent : Jupiter.text; }
        }
        Text {
            text: root.label;
            color: root.active ? Jupiter.on-accent : Jupiter.text;
            font-family: Jupiter.font-sans;
            font-size: Jupiter.font-sm;
            font-weight: root.active ? 700 : 400;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// ---- page building blocks (all sizes and colours come from the Jupiter global)
export component PageHead inherits HorizontalLayout {
    in property <string> eyebrow;
    in property <string> title;
    spacing: Jupiter.space-3;
    VerticalLayout {
        horizontal-stretch: 1;
        Text { text: root.eyebrow.to-uppercase(); font-family: Jupiter.font-mono; font-size: Jupiter.font-xs; color: Jupiter.accent; }
        Text { text: root.title; font-family: Jupiter.font-sans; font-size: Jupiter.font-xl; font-weight: 800; color: Jupiter.text; }
    }
    @children
}

export component Card inherits Rectangle {
    background: Jupiter.surface-raised;
    border-width: 1px;
    border-color: Jupiter.border;
    border-radius: Jupiter.radius-md;
    clip: true;
    VerticalLayout { @children }
}

// A table row: height follows the density tokens (cell-y), so Settings > Compact tightens every table.
export component TRow inherits Rectangle {
    in property <bool> first: false;
    in property <bool> header: false;
    in property <bool> selected: false;
    callback clicked();
    height: 18px + 2 * Jupiter.cell-y;
    background: selected ? Jupiter.accent : header ? Jupiter.surface : transparent;
    Rectangle { y: 0px; height: 1px; background: first ? transparent : Jupiter.border; }
    // under the cells, so a SortCell inside a header row still receives its own clicks
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: Jupiter.space-4;
        padding-right: Jupiter.space-4;
        spacing: Jupiter.space-3;
        @children
    }
}

export component TCell inherits Text {
    in property <bool> mono: false;
    in property <bool> head: false;
    in property <bool> right: false;
    font-family: mono || head ? Jupiter.font-mono : Jupiter.font-sans;
    font-size: head ? Jupiter.font-xs : Jupiter.font-sm;
    font-weight: head ? 400 : 400;
    color: head ? Jupiter.text-muted : Jupiter.text;
    vertical-alignment: center;
    horizontal-alignment: right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    overflow: elide;
}

export component SortCell inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> right: false;
    callback clicked();
    HorizontalLayout {
        alignment: right ? end : start;
        spacing: 4px;
        Text { text: root.text.to-uppercase() + (root.active ? " v" : ""); font-family: Jupiter.font-mono; font-size: Jupiter.font-xs; color: root.active ? Jupiter.accent : Jupiter.text-muted; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// A bar sparkline: `bars` are values already scaled to 0..1.
export component Spark inherits Rectangle {
    in property <[float]> bars;
    in property <color> tint: Jupiter.accent;
    min-height: 32px;
    HorizontalLayout {
        spacing: 2px;
        for b in root.bars : Rectangle {
            horizontal-stretch: 1;
            Rectangle { y: parent.height - self.height; height: max(2px, b * parent.height); border-radius: 1px; background: root.tint; }
        }
    }
}

export component Meter inherits Rectangle {
    in property <int> pct;
    height: 8px;
    border-radius: 4px;
    background: Jupiter.border;
    Rectangle {
        x: 0px;
        width: parent.width * min(1.0, root.pct / 100.0);
        border-radius: 4px;
        background: root.pct >= 100 ? Jupiter.danger : root.pct > 50 ? Jupiter.warn : Jupiter.ok;
    }
}

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 56px + Jupiter.cell-y;
    HorizontalLayout {
        padding-left: Jupiter.space-4;
        padding-right: Jupiter.space-4;
        spacing: Jupiter.space-3;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.label; font-family: Jupiter.font-sans; font-size: Jupiter.font-md; font-weight: 700; color: Jupiter.text; }
            Text { text: root.hint; font-family: Jupiter.font-sans; font-size: Jupiter.font-sm; color: Jupiter.text-muted; }
        }
        VerticalLayout { alignment: center; JToggle { checked: root.checked; toggled(c) => { root.toggled(c); } } }
    }
}

// A table cell that edits in place: click to start, Enter commits, Escape cancels (same keys as the web DataTable).
export component EditCell inherits Rectangle {
    in property <string> text;
    in property <bool> editing;
    in property <bool> mono: true;
    in property <bool> right: false;
    in property <color> tint: Jupiter.text;
    callback start();
    callback commit(string);
    callback cancel();
    changed editing => {
        if (self.editing) {
            ti.text = root.text;
            ti.select-all();
            ti.focus();
        }
    }
    Rectangle {
        visible: root.editing;
        border-width: 1px;
        border-color: Jupiter.accent;
        border-radius: Jupiter.radius-sm;
        background: Jupiter.bg;
    }
    ti := TextInput {
        visible: root.editing;
        x: 4px;
        width: parent.width - 8px;
        font-family: root.mono ? Jupiter.font-mono : Jupiter.font-sans;
        font-size: Jupiter.font-sm;
        color: Jupiter.text;
        vertical-alignment: center;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        accepted => { root.commit(self.text); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.cancel(); return accept; }
            return reject;
        }
    }
    Text {
        visible: !root.editing;
        x: 0px;
        width: parent.width;
        text: root.text;
        font-family: root.mono ? Jupiter.font-mono : Jupiter.font-sans;
        font-size: Jupiter.font-sm;
        color: root.tint;
        vertical-alignment: center;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
        overflow: elide;
    }
    TouchArea { enabled: !root.editing; clicked => { root.start(); } }
}
