{
  "name": "@belikh/jupiter-docs",
  "version": "1.3.2",
  "description": "Jupiter docs generator: one Markdown source (docs-src) becomes a themed static site, repo Markdown and a LaTeX/PDF document.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "jupiter-docs": "./bin/jupiter-docs.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build": "node bin/jupiter-docs.mjs check --config ../../docs.config.json"
  },
  "dependencies": {
    "@belikh/jupiter-github": "*",
    "@belikh/jupiter-graphics": "*",
    "@belikh/jupiter-tokens": "*",
    "markdown-it": "14.3.3",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@belikh/jupiter-fonts": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belikh/design.git",
    "directory": "packages/docs"
  }
}
